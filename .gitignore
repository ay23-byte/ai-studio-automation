# Secrets and local environment
.env
.env.*
!.env.example
env.local

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/

# Generated media and temporary renders
output/*
!output/.gitkeep
build/*
!build/.gitkeep
assets/music/*
!assets/music/.gitkeep
assets/clips/*
!assets/clips/.gitkeep

# Local runtime database (never commit user/job state)
db/*.sqlite
db/*.sqlite3
db/*.db

# Logs and OS/editor files
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Google OAuth credentials (never commit)
client_secret.json
client_secret*.json
oauth_token*.json
token.json
