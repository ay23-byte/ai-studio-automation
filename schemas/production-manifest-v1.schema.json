{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-studio/production-manifest-v1.schema.json",
  "title": "AI Studio production manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "mode",
    "topic",
    "video_file",
    "captions_file",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "longform",
        "shortform",
        "daily_news"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "video_file": {
      "type": "string",
      "minLength": 1
    },
    "captions_file": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "narration",
          "assets"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "narration": {
            "type": "string",
            "minLength": 1
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "asset_type",
                "provenance",
                "rights"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "asset_type": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {
                  "type": "object",
                  "required": [
                    "origin"
                  ],
                  "properties": {
                    "origin": {
                      "enum": [
                        "source",
                        "ai_generated",
                        "user_provided"
                      ]
                    },
                    "provider": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "source_url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "prompt": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "rights": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "reviewed",
                        "unknown",
                        "needs_permission"
                      ]
                    },
                    "license": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "attribution": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
