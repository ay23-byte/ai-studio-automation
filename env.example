# Copy this file to .env and fill in your keys

# Required for script generation (free at aistudio.google.com)
GEMINI_API_KEY=

# Required for AI images (free at dash.cloudflare.com > Workers AI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Required for stock footage backup (free at pixabay.com/api/docs)
PIXABAY_API_KEY=

# Required for YouTube upload
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Optional: Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: voice settings
CHANNEL_NAME=Power Codex
PRIVACY=private
# PUBLISH_AT_IST=19:00

# Optional: ElevenLabs (paid, but better voice quality)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
