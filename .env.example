# Copy this file to .env and add your own credentials.
# Never commit .env or share real API keys.

# Gemini: required for AI-generated scripts (demo mode works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated fallback models, tried in order if a model is rate-limited,
# unavailable or retired. Leave unset/empty for the built-in chain (core/gemini.py);
# write "none" to disable fallbacks. An invalid API key is never retried.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional documentary visual-to-narration vision screening.
# Opt in because it makes an additional Gemini vision request per shot.
# A "match" is only a triage signal; human visual/source review remains mandatory.
VISUAL_SEMANTIC_CHECK=0
VISUAL_SEMANTIC_MAX_SHOTS=40

# Consistent grade applied to all long-form documentary shots.
# Options: neutral, cinematic, warm, cool, archive
DOCUMENTARY_COLOR_GRADE=cinematic

# Final long-form documentary mix target (YouTube-friendly stereo master).
DOCUMENTARY_TARGET_LUFS=-16
DOCUMENTARY_TRUE_PEAK_DBFS=-1.5
DOCUMENTARY_TARGET_LRA=11

# Zero-paid image path: metered hosted inference providers are disabled.
# Pollinations is a keyless public endpoint; if unavailable, use source imagery/graphics.
POLLINATIONS_GAP=16

# Stock-video discovery. Pixabay requires its API key; NASA, Wikimedia Commons
# and Internet Archive are searched without API keys.
PIXABAY_API_KEY=
# Mixkit has no supported public search API; use its site manually.

# Paid hosted AI video providers (MuAPI/Replicate) are permanently disabled.\n\n# YouTube upload: required only when uploading videos
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Telegram notifications are optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Channel and publishing settings
CHANNEL_NAME=Engineering Physics
PRIVACY=private
# PUBLISH_AT_IST=19:00

# Subtitle presets: bold, clean, karaoke
SUBTITLE_PRESET=bold

# Optional voice overrides
VOICE_HINDI=hi-IN-MadhurNeural
VOICE_ENGLISH=en-IN-PrabhatNeural
VOICE_ENGLISH_FEMALE=en-IN-NeerjaNeural
VOICE_FEMALE=hi-IN-SwaraNeural

# Optional ElevenLabs settings (only if implemented/configured in your setup)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Optional narration pacing and pronunciation controls
TTS_RATE=-5%
TTS_PITCH=+0Hz
# Set TTS_PRONUNCIATION_MAP to a JSON object, e.g. {"GPU":"G P U"}
TTS_PRONUNCIATION_MAP=

# CPU-friendly still-image documentary presenter (no GPU; not lip-sync)
PRESENTER_ENABLED=1
PRESENTER_MODE=still_cpu
PRESENTER_IMAGE=assets/presenter/presenter_master.png

# Optional experimental genuine lip-sync mode; requires a separately provisioned GPU environment
# PRESENTER_MODE=sadtalker
SADTALKER_DIR=
SADTALKER_DEVICE=cpu

# ---------------------------------------------------------------------------
# Reliability, safety and automation (all optional; defaults shown)
# ---------------------------------------------------------------------------

# --- Upload safety ---------------------------------------------------------
# Uploads are PRIVATE and unscheduled unless this is explicitly enabled.
# Leave unset for automation; public release is a human action in the dashboard.
# ALLOW_PUBLIC_PUBLISH=0
# The uploader refuses to upload when the OAuth credentials belong to another
# channel. YT_CHANNEL_ID (UC...) is the most reliable; the handle is the fallback.
# YT_CHANNEL_ID=
# YT_CHANNEL_HANDLE=@engineeringphysics-n5g
# YT_CHANNEL_VERIFY=1
# PLAYLIST_PRIVACY=private
# POST_PINNED_COMMENT=0
# SKIP_PLAYLIST=0
# Override gates only after a human has reviewed the video:
# ALLOW_FALLBACK_VISUAL_UPLOAD=0
# ALLOW_DUPLICATE_UPLOAD=0
# REQUIRE_ASSET_PROVENANCE=0

# --- Script model fallbacks (free tiers; used only when Gemini fails) -------
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# GITHUB_MODELS_TOKEN=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_PROVIDER_ORDER=groq,cerebras,openrouter,mistral,github,ollama
# SHORTS_SCRIPT_ATTEMPTS=2

# --- Topics and duplicates -------------------------------------------------
# TOPIC_CATEGORIES=physics,engineering,technology,science
# DEDUPE_SIMILARITY_THRESHOLD=0.6
# AI_STUDIO_STATE_BRANCH=automation-state

# --- Rendering and recovery ------------------------------------------------
# AI_STUDIO_RESUME=1               # reuse completed stages when a job is re-run
# RETRY_FALLBACK_CARDS_ON_RESUME=1 # retry providers for scenes that fell back to a card
# VISUAL_FALLBACK_CARDS=1          # draw a disclosed explainer card when no provider answers
# VISUAL_FALLBACK_MAX_SHARE=0.5    # above this share the upload is blocked
# IMAGE_PROVIDER_FAILURE_LIMIT=2
# RENDER_JOIN_BATCH=16
# KEEP_RENDER_WORK=0
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe
# FFMPEG_DISABLE_XFADE=0
# SHORTS_CTA=

# --- Captions --------------------------------------------------------------
# SUBTITLE_LANGUAGE=english        # english | hindi | hinglish | source
# SUBTITLE_TRANSLATION_FALLBACK=fail   # fail | source
# SUBTITLE_FONTS_DIR=              # defaults to assets/fonts (bundled Noto Sans + Devanagari)
# SUBTITLE_FONT_LATIN=
# SUBTITLE_FONT_DEVANAGARI=

# --- Autonomous news Short --------------------------------------------------
# NEWS_LANGUAGE=english
# NEWS_SCRIPT_ATTEMPTS=2
# NEWS_TEMPLATE_FALLBACK=0         # model-free attributed script when no model is available

# --- Notifications (any combination) ----------------------------------------
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# NOTIFY_WEBHOOK_URL=

# --- Paths (sandboxes, tests, a second drive) --------------------------------
# AI_STUDIO_DB_PATH=
# AI_STUDIO_OUTPUT_DIR=
# AI_STUDIO_BUILD_DIR=
# AI_STUDIO_STATE_DIR=
# AI_STUDIO_LOG_DIR=
