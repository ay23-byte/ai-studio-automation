# Copy this file to .env and add your own credentials.
# Never commit .env or share real API keys.

# Gemini: required for AI-generated scripts (demo mode works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated fallback models, tried in order if a model is temporarily unavailable
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional documentary visual-to-narration vision screening.
# Opt in because it makes an additional Gemini vision request per shot.
# A "match" is only a triage signal; human visual/source review remains mandatory.
VISUAL_SEMANTIC_CHECK=0
VISUAL_SEMANTIC_MAX_SHOTS=40

# Consistent grade applied to all long-form documentary shots.
# Options: neutral, cinematic, warm, cool, archive
DOCUMENTARY_COLOR_GRADE=cinematic

# Final long-form documentary mix target (YouTube-friendly stereo master).
DOCUMENTARY_TARGET_LUFS=-16
DOCUMENTARY_TRUE_PEAK_DBFS=-1.5
DOCUMENTARY_TARGET_LRA=11

# Zero-paid image path: metered hosted inference providers are disabled.
# Pollinations is a keyless public endpoint; if unavailable, use source imagery/graphics.
POLLINATIONS_GAP=16

# Stock-video discovery. Pixabay requires its API key; NASA, Wikimedia Commons
# and Internet Archive are searched without API keys.
PIXABAY_API_KEY=
# Mixkit has no supported public search API; use its site manually.

# Paid hosted AI video providers (MuAPI/Replicate) are permanently disabled.\n\n# YouTube upload: required only when uploading videos
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Telegram notifications are optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Channel and publishing settings
CHANNEL_NAME=Engineering Physics
PRIVACY=private
# PUBLISH_AT_IST=19:00

# Subtitle presets: bold, clean, karaoke
SUBTITLE_PRESET=bold

# Optional voice overrides
VOICE_HINDI=hi-IN-MadhurNeural
VOICE_ENGLISH=en-IN-PrabhatNeural
VOICE_ENGLISH_FEMALE=en-IN-NeerjaNeural
VOICE_FEMALE=hi-IN-SwaraNeural

# Optional ElevenLabs settings (only if implemented/configured in your setup)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Optional narration pacing and pronunciation controls
TTS_RATE=-5%
TTS_PITCH=+0Hz
# Set TTS_PRONUNCIATION_MAP to a JSON object, e.g. {"GPU":"G P U"}
TTS_PRONUNCIATION_MAP=

# CPU-friendly still-image documentary presenter (no GPU; not lip-sync)
PRESENTER_ENABLED=1
PRESENTER_MODE=still_cpu
PRESENTER_IMAGE=assets/presenter/presenter_master.png

# Optional experimental genuine lip-sync mode; requires a separately provisioned GPU environment
# PRESENTER_MODE=sadtalker
SADTALKER_DIR=
SADTALKER_DEVICE=cpu
